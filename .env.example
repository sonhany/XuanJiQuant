# XuanJiQuant local environment template.
# Copy to .env for local use. Do not commit real secrets.

# Server control plane
# The browser token must match XUANJI_API_TOKEN.
XUANJI_API_TOKEN=
VITE_XUANJI_API_TOKEN=
# Leave empty when Vite proxies /api to the local server.
VITE_API_BASE=
ALLOWED_ORIGINS=http://localhost:8888,http://127.0.0.1:8888
HOST=127.0.0.1
PORT=8880

# GLM LLM provider
GLM_API_KEY=
GLM_BASE_URL=https://api.ifanr.work/
GLM_MODEL=glm-5.2

# OpenCode Zen LLM provider (free models available)
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash-free

# TdxQuant-first data policy
XUANJI_TDX_QUANT_FIRST=1

# Official market sentiment sources
FRED_API_KEY=
CFFEX_MARKET_DATA_URL=

# Jin10 MCP macro/news/calendar data
JIN10_MCP_SERVER_URL=https://mcp.jin10.com/mcp
JIN10_MCP_PROTOCOL_VERSION=2025-11-25
JIN10_MCP_BEARER_TOKEN=
JIN10_MCP_TIMEOUT=20

# Optional Tushare Pro MCP (token may be carried in the URL query string)
TUSHARE_MCP_SERVER_URL=
TUSHARE_MCP_PROTOCOL_VERSION=2025-11-25
TUSHARE_MCP_TIMEOUT=20

# Optional storage
QUANT_CACHE=sqlite

# Optional Python override
PYTHON=
# 选股证据最长有效期，以及进入一次 Agent 周期前必须保留的安全余量（秒）。
AI_SCREEN_TTL_SEC=3600
AI_SCREEN_MIN_VALIDITY_SEC=1800
